# Time-Traveler MCP Bridge — environment variables
# Copy to .env and fill in values before running mcp_bridge.py locally.
# On the GCP VM the systemd service sets these via Environment= lines.

# ── Gemini AI agents ─────────────────────────────────────────────────────────
# Create this key in Google AI Studio. Never commit a real key.
GEMINI_API_KEY=your-gemini-api-key

# Used by the LangGraph Architect, Auditor, and Data Smith nodes
GEMINI_MODEL=gemini-2.5-flash

# ── MCP Bridge ────────────────────────────────────────────────────────────────
# Secret token — must match X-API-Key header used by agents
MCP_API_KEY=your-secret-api-key

# Main Compose database password (required by docker-compose.yml)
POSTGRES_PASSWORD=replace-with-a-strong-local-password

# Optional; generated randomly at bridge startup when omitted
SHADOW_DB_PASSWORD=

# Public IP or hostname of the VM/host where mcp_bridge.py runs
VM_PUBLIC_IP=your-vm-public-ip

# Port mcp_bridge.py listens on
MCP_PORT=8888

# LangGraph client connection (used by flows/orchestrator.py)
BRIDGE_URL=http://your-bridge-host:8888
MCP_BRIDGE_URL=http://your-bridge-host:8888

# ── Registry ──────────────────────────────────────────────────────────────────
# Container registry for backend and frontend images (e.g. ghcr.io/<owner>/<repo>)
REGISTRY=ghcr.io/your-org/your-repo

# ── GitHub integration ────────────────────────────────────────────────────────
# Personal Access Token with repo scope — used to post PR comments and merge PRs
# Leave blank to disable automatic PR comment posting
GITHUB_TOKEN=your-github-pat-with-repo-scope

# GitHub repository path (owner/repo)
GITHUB_REPOSITORY=your-org/your-repo

# ── Shadow Clone lifecycle ────────────────────────────────────────────────────
# Hours before a clone is automatically torn down
CLONE_TTL_HOURS=2

# ── Cloud Run overflow ────────────────────────────────────────────────────────
# GCP project ID for Cloud Run deployments when VM headroom is insufficient
# Leave blank to disable Cloud Run overflow
CLOUD_RUN_PROJECT=your-gcp-project-id

# Cloud Run region
CLOUD_RUN_REGION=us-central1

# ── Paths on the host/VM ──────────────────────────────────────────────────────
# Absolute path to the cloned repository
REPO_DIR=/path/to/time-traveler

# Absolute path to the base schema SQL file mounted into every shadow DB
SCHEMA_SQL=/path/to/time-traveler/db/schema.sql
